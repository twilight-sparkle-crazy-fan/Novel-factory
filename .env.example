# 相对路径以项目根目录为准
MODEL_MODE=local
MODEL_PATH=model/your-model.gguf
LLAMA_SERVER_BIN=llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
APP_HOST=127.0.0.1
APP_PORT=8000

# Apple Silicon 默认由 llama.cpp 自动安排 Metal offload
N_CTX=40960
N_GPU_LAYERS=auto
N_PARALLEL=1
PROMPT_CACHE_MB=512
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# 小说写作默认关闭长思考，避免输出额度全部消耗在 reasoning
REASONING=off
AUTO_START_LLAMA=true
LLAMA_START_TIMEOUT=180
LLAMA_LOG_MAX_BYTES=5242880
LLAMA_LOG_BACKUP_COUNT=3

DATABASE_PATH=data/novel-factory.db
MAX_CANDIDATES_PER_EXCHANGE=20

# `novel --api` 会临时覆盖 MODEL_MODE；Key 必须在页面右上角填写，不写入此文件
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
API_CONTEXT_SIZE=81920

# 实验资料系统默认关闭；打开后启用 .llm4pkg 分析包 API
EXPERIMENTAL_MATERIAL_SYSTEM=false
